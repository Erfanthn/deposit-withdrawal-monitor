# Copy this file to .env and fill in your own values. Never commit .env.
# Use read-only API keys: these endpoints only read coin settings.
MEXC_API_KEY=
MEXC_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Leave these empty to print alerts to the console instead of Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
